{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "cross_model_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "model", "status", "evidence_path", "note"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "status": { "enum": ["unrun", "pass", "partial", "fail"] },
        "evidence_path": { "type": ["string", "null"] },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "generated_at", "repository_revision", "runner", "summary", "cases", "cross_model_runs"],
  "properties": {
    "suite_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "repository_revision": { "type": "string", "minLength": 1 },
    "runner": { "const": "scripts/run-evals.mjs" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "failed", "total", "score", "max_score"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "score": { "type": "integer", "minimum": 0 },
        "max_score": { "type": "integer", "minimum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "score", "max_score", "assertions"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL"] },
          "score": { "type": "integer", "minimum": 0 },
          "max_score": { "type": "integer", "minimum": 1 },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "severity", "weight", "actual"],
              "properties": {
                "id": { "type": "string" },
                "status": { "enum": ["PASS", "FAIL"] },
                "severity": { "enum": ["P0", "P1", "P2", "P3"] },
                "weight": { "type": "integer" },
                "actual": {}
              }
            }
          }
        }
      }
    },
    "cross_model_runs": { "type": "array", "items": { "$ref": "#/definitions/cross_model_run" } }
  }
}
