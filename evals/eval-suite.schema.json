{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "suite_version", "cases", "cross_model_runs"],
  "properties": {
    "$schema": { "type": "string" },
    "suite_version": { "const": "1.0.0" },
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "fixture_path", "rubric_path", "assertions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": { "enum": ["activation", "nonactivation", "orchestration", "claims", "section_approval", "media", "browser", "webgl_3d", "red_team"] },
          "fixture_path": { "type": "string", "minLength": 1 },
          "rubric_path": { "type": "string", "minLength": 1 },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "pointer", "operator", "expected", "severity", "weight"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "pointer": { "type": "string" },
                "operator": { "enum": ["equals", "contains_all", "excludes_all", "length_at_least", "matches", "schema_valid"] },
                "expected": {},
                "severity": { "enum": ["P0", "P1", "P2", "P3"] },
                "weight": { "type": "integer", "minimum": 1, "maximum": 4 }
              }
            }
          }
        }
      }
    },
    "cross_model_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime", "model", "status", "evidence_path", "note"],
        "properties": {
          "runtime": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "status": { "enum": ["unrun", "pass", "partial", "fail"] },
          "evidence_path": { "type": ["string", "null"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
