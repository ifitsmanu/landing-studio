{
  "$schema": "./eval-suite.schema.json",
  "suite_version": "1.0.0",
  "cases": [
    {
      "id": "activation-full-studio",
      "category": "activation",
      "fixture_path": "evals/fixtures/activation-full-studio.json",
      "rubric_path": "evals/rubrics/routing.md",
      "assertions": [
        { "id": "director", "pointer": "/observed/primary_skill", "operator": "equals", "expected": "landing-page-build", "severity": "P1", "weight": 3 },
        { "id": "specialists", "pointer": "/observed/activated_skills", "operator": "contains_all", "expected": ["landing-research", "creative-direction", "landing-page-implementation", "landing-page-qa", "landing-red-team"], "severity": "P1", "weight": 3 },
        { "id": "section-scope", "pointer": "/observed/production_scope", "operator": "equals", "expected": "one-section-at-a-time", "severity": "P1", "weight": 3 }
      ]
    },
    {
      "id": "nonactivation-narrow-copy",
      "category": "nonactivation",
      "fixture_path": "evals/fixtures/nonactivation-narrow-copy.json",
      "rubric_path": "evals/rubrics/routing.md",
      "assertions": [
        { "id": "narrow-route", "pointer": "/observed/activated_skills", "operator": "equals", "expected": ["landing-copywriter"], "severity": "P1", "weight": 3 },
        { "id": "no-studio-state", "pointer": "/observed/state_created", "operator": "equals", "expected": false, "severity": "P1", "weight": 3 },
        { "id": "avoid-heavy-skills", "pointer": "/observed/not_activated", "operator": "contains_all", "expected": ["landing-page-build", "motion-video", "webgl-3d"], "severity": "P2", "weight": 2 }
      ]
    },
    {
      "id": "orchestration-one-section",
      "category": "orchestration",
      "fixture_path": "evals/fixtures/orchestration-one-section.json",
      "rubric_path": "evals/rubrics/workflow.md",
      "assertions": [
        { "id": "active-only", "pointer": "/observed/implementation_scope", "operator": "equals", "expected": ["hero"], "severity": "P1", "weight": 3 },
        { "id": "direction-approved", "pointer": "/observed/sections/0/stage", "operator": "equals", "expected": "direction_approved", "severity": "P1", "weight": 3 },
        { "id": "downstream-queued", "pointer": "/observed/sections/1/stage", "operator": "equals", "expected": "queued", "severity": "P1", "weight": 3 }
      ]
    },
    {
      "id": "claims-integrity",
      "category": "claims",
      "fixture_path": "evals/fixtures/claims-integrity.json",
      "rubric_path": "evals/rubrics/integrity.md",
      "assertions": [
        { "id": "ledger-schema", "pointer": "/observed/ledger", "operator": "schema_valid", "expected": "schemas/evidence-ledger.schema.json", "severity": "P1", "weight": 3 },
        { "id": "verified-publishes", "pointer": "/observed/publishable_claim_ids", "operator": "contains_all", "expected": ["claim-verified"], "severity": "P1", "weight": 3 },
        { "id": "unknown-blocked", "pointer": "/observed/blocked_claim_ids", "operator": "contains_all", "expected": ["claim-unknown"], "severity": "P0", "weight": 4 }
      ]
    },
    {
      "id": "section-approval-lock",
      "category": "section_approval",
      "fixture_path": "evals/fixtures/section-approval-lock.json",
      "rubric_path": "evals/rubrics/workflow.md",
      "assertions": [
        { "id": "preapproval-block", "pointer": "/observed/before_approval/error_code", "operator": "equals", "expected": "DIRECTION_APPROVAL_REQUIRED", "severity": "P1", "weight": 3 },
        { "id": "postapproval-allowed", "pointer": "/observed/after_approval/allowed", "operator": "equals", "expected": true, "severity": "P1", "weight": 3 },
        { "id": "downstream-stale", "pointer": "/observed/after_rejection/downstream_stale", "operator": "equals", "expected": true, "severity": "P1", "weight": 3 }
      ]
    },
    {
      "id": "media-rights-block",
      "category": "media",
      "fixture_path": "evals/fixtures/media-rights-block.json",
      "rubric_path": "evals/rubrics/integrity.md",
      "assertions": [
        { "id": "ledger-schema", "pointer": "/observed/ledger", "operator": "schema_valid", "expected": "schemas/media-ledger.schema.json", "severity": "P1", "weight": 3 },
        { "id": "pending-excluded", "pointer": "/observed/release_asset_ids", "operator": "excludes_all", "expected": ["asset-pending"], "severity": "P0", "weight": 4 },
        { "id": "release-blocked", "pointer": "/observed/decision", "operator": "equals", "expected": "BLOCK", "severity": "P0", "weight": 4 }
      ]
    },
    {
      "id": "browser-evidence-contract",
      "category": "browser",
      "fixture_path": "evals/fixtures/browser-evidence-contract.json",
      "rubric_path": "evals/rubrics/integrity.md",
      "assertions": [
        { "id": "report-schema", "pointer": "/observed", "operator": "schema_valid", "expected": "schemas/browser-report.schema.json", "severity": "P1", "weight": 3 },
        { "id": "three-engines", "pointer": "/observed/projects", "operator": "length_at_least", "expected": 3, "severity": "P1", "weight": 3 },
        { "id": "evidence-pass", "pointer": "/observed/decision", "operator": "equals", "expected": "PASS", "severity": "P1", "weight": 3 }
      ]
    },
    {
      "id": "webgl-fallback-budget",
      "category": "webgl_3d",
      "fixture_path": "evals/fixtures/webgl-fallback-budget.json",
      "rubric_path": "evals/rubrics/integrity.md",
      "assertions": [
        { "id": "fallback", "pointer": "/observed/fallback/artifact", "operator": "matches", "expected": "\\.(avif|webp|png)$", "severity": "P1", "weight": 3 },
        { "id": "reduced-motion", "pointer": "/observed/reduced_motion", "operator": "equals", "expected": "static-fallback", "severity": "P1", "weight": 3 },
        { "id": "gpu-budget", "pointer": "/observed/budgets/max_gpu_frame_ms", "operator": "equals", "expected": 16.7, "severity": "P2", "weight": 2 }
      ]
    },
    {
      "id": "red-team-p1-block",
      "category": "red_team",
      "fixture_path": "evals/fixtures/red-team-p1-block.json",
      "rubric_path": "evals/rubrics/integrity.md",
      "assertions": [
        { "id": "report-schema", "pointer": "/observed", "operator": "schema_valid", "expected": "schemas/red-team-report.schema.json", "severity": "P1", "weight": 3 },
        { "id": "fresh-context", "pointer": "/observed/fresh_context", "operator": "equals", "expected": true, "severity": "P1", "weight": 3 },
        { "id": "blocking-decision", "pointer": "/observed/decision", "operator": "equals", "expected": "BLOCK", "severity": "P0", "weight": 4 }
      ]
    }
  ],
