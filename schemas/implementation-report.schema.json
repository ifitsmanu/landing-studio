{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifitsmanu.github.io/landing-studio/schemas/implementation-report.schema.json",
  "title": "Landing Studio section implementation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "section_id", "route", "source_files", "build", "tests", "claims_used", "media_assets_used", "dependencies_used"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "section_id": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "minLength": 1 },
    "source_files": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/file" } },
    "build": { "$ref": "#/definitions/check" },
    "tests": { "$ref": "#/definitions/check" },
    "claims_used": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "media_assets_used": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependencies_used": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "evidence"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "const": 0 },
        "evidence": { "$ref": "#/definitions/file" }
      }
    }
  }
}
